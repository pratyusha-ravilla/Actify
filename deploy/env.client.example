# client/.env.production  —  build-time only, inlined into the bundle by Vite.
# Anything here is PUBLIC. Never put secrets, tokens, or connection strings in this file.
#
# Same-origin deploy (recommended): SPA and API behind one Nginx vhost -> no CORS needed.
VITE_API_BASE_URL=/api

# Cross-origin alternative (API on its own host):
# VITE_API_BASE_URL=https://api.<DOMAIN>/api
#
# Local development (default when unset in code): http://localhost:5002/api
