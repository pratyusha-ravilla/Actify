# /etc/actify/api.env  —  root:actify 0640, never committed
# Copy: install -m 640 -o root -g actify deploy/env.server.example /etc/actify/api.env

# --- runtime ---
NODE_ENV=production
PORT=5002
HOST=127.0.0.1
TZ=Asia/Kolkata

# --- database ---
# Rotate the password in Atlas before using this. URL-encode special characters.
MONGO_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/actify?retryWrites=true&w=majority

# --- auth ---
# openssl rand -base64 48
JWT_SECRET=<GENERATE_WITH_openssl_rand_-base64_48>
JWT_EXPIRES_IN=7d

# --- CORS: comma separated, no trailing slash ---
CORS_ORIGINS=https://<DOMAIN>,https://<WWW_DOMAIN>

# --- email (Gmail app password; 2FA must be enabled on the account) ---
EMAIL_USER=<GMAIL_ADDRESS>
EMAIL_PASS=<16_CHAR_APP_PASSWORD>
EMAIL_FROM_NAME=Actify

# --- storage ---
UPLOAD_DIR=/var/lib/actify/uploads

# --- puppeteer: leave empty to use the Chrome downloaded by `npx puppeteer browsers install chrome`
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# PUPPETEER_CACHE_DIR=/var/lib/actify/.cache/puppeteer
